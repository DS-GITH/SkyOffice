# Banco Postgres (local: docker compose up -d)
DATABASE_URL=postgres://xpert:xpert@localhost:54330/xpert_office

# Segredo para assinar as sessões (use um valor longo e aleatório em produção)
JWT_SECRET=troque-este-segredo

# Admin criado automaticamente no primeiro boot (se ainda não existir admin)
ADMIN_EMAIL=admin@xpertdev.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Admin
